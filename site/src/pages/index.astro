---
import "../styles/washi.css";
import { Image } from "astro:assets";
import logo from "../assets/kikigaki.png";
import Media from "../components/Media.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const docs = `${base}/docs/getting-started/`;
const repo = "https://github.com/tadashi-aikawa/kikigaki";
const blog = "https://nocturne.mamansoft.net/tags/KIKIGAKI/";
const siteUrl = "https://tadashi-aikawa.github.io/kikigaki/";
const title = "KIKIGAKI 聞書";
const heading = "声をすべてドキュメントに";
const description =
  "会議やひとりの声を、話す人ごとに書き起こしてMarkdownに残すmacOSアプリ。Claude CodeやCodexも会議に参加できます。";
const installCommand = "brew install --cask tadashi-aikawa/tap/kikigaki";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={`${title} | ${heading}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}kikigaki.png`} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href={`${base}/`}>
        <Image src={logo} alt="" width={24} height={24} />
        <b>KIKIGAKI</b><i>聞書</i>
      </a>
      <nav aria-label="サイト">
        <a href="#features">機能</a>
        <a href="#install">導入</a>
        <a href={docs}>ドキュメント</a>
        <a href={repo}>GitHub</a>
        <a href={blog} target="_blank" rel="noopener noreferrer">ブログ</a>
      </nav>
    </header>

    <main>
      <section class="first">
        <h1>{heading}</h1>

        <div class="pillars">
          <div class="pl">
            <div class="sheet ill">
              <Media src="illustrations/meeting.png" alt="会議の場面のイラスト">
                <div class="ph ph-ill">
                  <svg viewBox="0 0 340 180" aria-hidden="true">
                    <ellipse cx="170" cy="128" rx="120" ry="30"></ellipse>
                    <circle cx="70" cy="62" r="13"></circle><path d="M48 104q22-30 44 0"></path>
                    <circle cx="170" cy="40" r="13"></circle><path d="M148 82q22-30 44 0"></path>
                    <circle cx="270" cy="62" r="13"></circle><path d="M248 104q22-30 44 0"></path>
                    <path d="M150 132h40l6-26h-52z"></path><path d="M156 116h26M156 122h20"></path>
                    <path d="M92 50h28v14h-22l-6 6z" stroke="#3E706C"></path>
                    <path d="M192 26h28v14h-22l-6 6z" stroke="#C4801F"></path>
                    <path d="M228 50h-28v14h22l6 6z" stroke="#514A43"></path>
                    <rect x="296" y="96" width="26" height="18" rx="5" stroke="#3E706C" stroke-dasharray="3 3"></rect>
                  </svg>
                  <small>イラスト仮置き</small>
                </div>
              </Media>
            </div>
            <div class="tag t">会議で</div>
            <h2>話す人ごとに、AIも席に</h2>
            <p>誰が何を言ったかを分けて書き留めます。<br />AIは流れを読んで、論点や議事録をまとめます。</p>
          </div>

          <div class="pl">
            <div class="sheet ill">
              <Media src="illustrations/solo.png" alt="ひとりで話す場面のイラスト">
                <div class="ph ph-ill">
                  <svg viewBox="0 0 340 180" aria-hidden="true">
                    <circle cx="70" cy="70" r="14"></circle><path d="M44 130q4-42 40-40"></path>
                    <path d="M30 140h150"></path><path d="M110 138l10-34h40l-6 34"></path>
                    <path d="M90 66q14-8 24 0t24 0" stroke="#3E706C"></path>
                    <rect x="150" y="40" width="18" height="14" stroke="#C4801F"></rect>
                    <rect x="176" y="62" width="18" height="14" stroke="#3E706C"></rect>
                    <rect x="160" y="84" width="18" height="14" stroke="#514A43"></rect>
                    <path d="M200 70h30" stroke-dasharray="3 4"></path>
                    <rect x="240" y="34" width="66" height="90" rx="2"></rect>
                    <path d="M252 50h34M252 66h42M252 78h38M252 90h30"></path>
                    <rect x="290" y="112" width="26" height="18" rx="5" stroke="#3E706C" stroke-dasharray="3 3"></rect>
                  </svg>
                  <small>イラスト仮置き</small>
                </div>
              </Media>
            </div>
            <div class="tag g">ひとりで</div>
            <h2>ひとりの声を、AIと形に</h2>
            <p>プレゼンの練習やアイデアの壁打ちに。<br />話した言葉をAIが拾って、構成やメモにまとめます。</p>
          </div>
        </div>

        <a class="to-movie" href="#movie" aria-label="動画を見る">
          <svg viewBox="0 0 32 40" aria-hidden="true">
            <path d="M16 4v30M7 25l9 9 9-9"></path>
          </svg>
        </a>
      </section>

      <section class="movie" id="movie">
        <div class="sheet">
          <Media src="demos/transcription.mp4" alt="対面の会議を録音中の書き起こしウィンドウ">
            <div class="ph ph-movie">
              <div class="what">
                <div class="play"></div>
                <b>動画 15〜20秒・無音ループ</b>
                対面の会議を録音中の書き起こしウィンドウ。<br />3人の発話が話者色つきで薄く出て、濃く決まっていく。<br />途中でAIの返事が1つ、発話の間に入る。
              </div>
              <small>動画仮置き</small>
            </div>
          </Media>
        </div>
        <p class="movie-caption">3人の会議を録音中。話すと薄く出て、決まると濃くなる。頼むとAIの返事が並ぶ</p>
      </section>

      <section class="points" id="features">
        <div class="pt">
          <div class="shot sheet">
            <Media src="captures/speakers.png" alt="3人の会議の書き起こし。最後の行が半透明">
              <div class="ph ph-shot">
                <div class="what"><b>キャプチャ</b>3人の会議の書き起こし。<br />上の行は濃く、最後の1〜2行が半透明。<br />話者名は付け直した名前で。</div>
                <small>画面仮置き</small>
              </div>
            </Media>
          </div>
          <div class="text">
            <div class="tag t">話す人ごとに</div>
            <h3>誰の声かを分けて書く</h3>
            <p>まだ変わるかもしれない行は薄く、<br />決まると濃くなります。<br />名前はあとから付け直せます。</p>
          </div>
        </div>

        <div class="pt r">
          <div class="shot sheet">
            <Media src="captures/ai-reply.png" alt="発話の行の間に並ぶAIの返事">
              <div class="ph ph-shot">
                <div class="what"><b>キャプチャ</b>発話の行の間に、AIの返事の行が並ぶところ。<br />返事は見出しと箇条書きのある短いまとめ。</div>
                <small>画面仮置き</small>
              </div>
            </Media>
          </div>
          <div class="text">
            <div class="tag g">AIも同じ流れに</div>
            <h3>AIの返事が話と並ぶ</h3>
            <p>頼んだ返事が、話の流れの中に入ってきます。<br />返事をするのはClaude CodeかCodex。頼み方は自分で決められます。</p>
          </div>
        </div>

        <div class="pt">
          <div class="shot sheet">
            <Media src="captures/minutes.png" alt="書き起こしの右に議事録ペインを開いた画面">
              <div class="ph ph-shot">
                <div class="what"><b>キャプチャ</b>書き起こしの右に議事録ペインを開いた全体。<br />左に会話、右にAIが書いた議事録。</div>
                <small>画面仮置き</small>
              </div>
            </Media>
          </div>
          <div class="text">
            <div class="tag s">議事録</div>
            <h3>議事録をその場で読む</h3>
            <p>AIが書いた議事録を、<br />書き起こしの右に開いて読めます。<br />書き換わると表示も追いつきます。</p>
          </div>
        </div>

        <div class="pt r">
          <div class="shot sheet">
            <Media src="captures/board.png" alt="議事録ペインのボードタブに、論点と決まったことが並ぶ画面">
              <div class="ph ph-shot">
                <div class="what"><b>キャプチャ</b>議事録ペインの「ボード」タブを開いたところ。</div>
                <small>画面仮置き</small>
              </div>
            </Media>
          </div>
          <div class="text">
            <div class="tag s">ボード</div>
            <h3>いま何の話かを、一枚で</h3>
            <p>議事録は、あとで読むもの。会議の途中で見るのはボード。論点と決まったことを、AIが一枚に更新し続けます。</p>
          </div>
        </div>

        <div class="pt">
          <div class="shot sheet">
            <Media src="captures/earphones.png" alt="録音開始シートでシステム音声を取り込む設定">
              <div class="ph ph-shot">
                <div class="what"><b>キャプチャ</b>録音開始シートで<br />マイクとシステム音声の混合を選んだところ。</div>
                <small>画面仮置き</small>
              </div>
            </Media>
          </div>
          <div class="text">
            <div class="tag t">イヤホンでも</div>
            <h3>相手の声も聞き取る</h3>
            <p>オンライン会議では、Macで流れる相手の声も<br />マイクと一緒に取り込みます。</p>
          </div>
        </div>
      </section>

      <p class="more"><span>URLや画像の手入力</span><span>会話をコピーしてほかのAIへ</span><span>会議ごとにMarkdownで保存</span></p>

      <section class="install" id="install">
        <h3>入れる</h3>
        <div class="cmd">
          <span><i>$</i> <code id="install-command">{installCommand}</code></span>
          <button type="button" data-copy="install-command">コピー</button>
        </div>
        <p>macOS 26以降。<br />初めて使うときに、話者判別のモデル(約193 MB)を取得します。</p>
      </section>
    </main>

    <footer>
      <a class="brand" href={`${base}/`}>
        <Image src={logo} alt="" width={22} height={22} />
        <b>KIKIGAKI</b><em>聞書</em>
      </a>
      <nav aria-label="フッター">
        <a href={docs}>ドキュメント</a>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/blob/main/LICENSE`}>MIT License</a>
        <a href={blog} target="_blank" rel="noopener noreferrer">ブログ</a>
      </nav>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
        button.addEventListener("click", async () => {
          const target = document.getElementById(button.dataset.copy ?? "");
          if (!target?.textContent) return;
          try {
            await navigator.clipboard.writeText(target.textContent);
            button.textContent = "コピーしました";
          } catch {
            button.textContent = "コピーできません";
          }
          setTimeout(() => (button.textContent = "コピー"), 2000);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    color: var(--washi-ink);
    font-family: var(--washi-font);
    background: var(--washi-paper) var(--washi-noise);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* ヘッダーとフッター */
  .nav,
  footer {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 32px;
    color: var(--washi-muted);
  }

  .nav {
    min-height: 64px;
    padding: 0 72px;
    font-size: 13px;
  }

  footer {
    margin-top: 120px;
    padding: 28px 72px 36px;
    font-size: 13px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    margin-right: auto;
  }

  .brand img {
    margin-right: 10px;
  }

  .brand b {
    color: var(--washi-ink);
    font-size: 14px;
    letter-spacing: 0.18em;
  }

  footer .brand b {
    font-size: 13px;
  }

  .brand i,
  .brand em {
    font-style: normal;
    margin-left: 10px;
  }

  .nav nav,
  footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }

  .nav nav a:hover,
  footer nav a:hover {
    color: var(--washi-ink);
  }

  /* 紙の面 */
  .sheet {
    position: relative;
    background: var(--washi-sheet);
    border-radius: 4px;
    box-shadow: var(--washi-sheet-shadow);
    overflow: hidden;
  }

  .ph {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .ph small {
    position: absolute;
    bottom: 8px;
    right: 12px;
    font-size: 10px;
    color: var(--washi-placeholder);
  }

  .what {
    padding: 0 24px;
    font-size: 14px;
    line-height: 1.9;
    color: var(--washi-muted);
  }

  .what b {
    display: block;
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--washi-placeholder);
  }

  .tag {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .tag.t {
    color: var(--washi-teal);
  }

  .tag.g {
    color: var(--washi-gold);
  }

  .tag.s {
    color: var(--washi-sumi);
  }

  /* ファーストビュー */
  .first {
    max-width: 1280px;
    margin: 0 auto;
    text-align: center;
    padding: 44px 120px 0;
  }

  h1 {
    font-size: clamp(34px, 6vw, 60px);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 88px;
    padding-top: 52px;
  }

  .ph-ill {
    height: 240px;
  }

  .pl:first-child .ill {
    transform: rotate(-0.6deg);
  }

  .pl:last-child .ill {
    transform: rotate(0.5deg);
  }

  .ill svg {
    width: 340px;
    max-width: 100%;
    height: auto;
    fill: none;
    stroke: var(--washi-ink);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pl .tag {
    display: inline-block;
    margin-top: 26px;
  }

  h2 {
    margin-top: 6px;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .pl p {
    margin-top: 10px;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--washi-body);
  }

  .to-movie {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 34px;
    width: 44px;
    height: 44px;
    color: var(--washi-muted);
  }

  .to-movie:hover {
    color: var(--washi-ink);
  }

  .to-movie svg {
    width: 32px;
    height: 40px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 動画 */
  .movie {
    max-width: 1280px;
    margin: 0 auto;
    padding: 96px 120px 0;
  }

  .movie .sheet {
    transform: rotate(-0.25deg);
  }

  .movie-caption {
    margin-top: 20px;
    text-align: center;
    font-size: 14px;
    line-height: 1.9;
    color: var(--washi-muted);
  }

  .ph-movie {
    height: 584px;
  }

  .play {
    position: relative;
    width: 56px;
    height: 56px;
    margin: 0 auto 18px;
    border: 1.4px solid var(--washi-placeholder);
    border-radius: 50%;
  }

  .play::after {
    content: "";
    position: absolute;
    left: 22px;
    top: 17px;
    border-left: 16px solid var(--washi-placeholder);
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
  }

  /* ポイント */
  .points {
    max-width: 1280px;
    margin: 0 auto;
    padding: 120px 120px 0;
    display: grid;
    gap: 112px;
  }

  .pt {
    display: grid;
    grid-template-columns: 600px 1fr;
    gap: 72px;
    align-items: center;
  }

  .pt.r {
    grid-template-columns: 1fr 600px;
  }

  .pt.r .shot {
    order: 2;
  }

  .ph-shot {
    height: 380px;
  }

  .pt:nth-child(1) .sheet {
    transform: rotate(-0.5deg);
  }

  .pt:nth-child(2) .sheet {
    transform: rotate(0.45deg);
  }

  .pt:nth-child(3) .sheet {
    transform: rotate(-0.4deg);
  }

  .pt:nth-child(4) .sheet {
    transform: rotate(0.5deg);
  }

  .pt:nth-child(5) .sheet {
    transform: rotate(-0.4deg);
  }

  h3 {
    margin-top: 8px;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .pt p {
    margin-top: 14px;
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--washi-body);
  }

  .more {
    margin-top: 96px;
    padding: 0 16px;
    text-align: center;
    font-size: 14px;
    line-height: 2;
    color: var(--washi-muted);
  }

  .more span {
    display: inline-block;
  }

  .more span + span::before {
    content: "・";
    margin: 0 14px;
    color: var(--washi-placeholder);
  }

  /* 導入 */
  .install {
    padding: 136px 16px 0;
    text-align: center;
  }

  .install h3 {
    margin: 0;
  }

  .cmd {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    max-width: 100%;
    margin-top: 24px;
    padding: 16px 18px 16px 26px;
    font: 15px/1 var(--washi-font-mono);
    background: var(--washi-sheet);
    border-radius: 4px;
    box-shadow: var(--washi-sheet-shadow);
  }

  .cmd > span {
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    text-align: left;
  }

  .cmd i {
    font-style: normal;
    color: var(--washi-placeholder);
  }

  .cmd code {
    font: inherit;
  }

  .cmd button {
    flex-shrink: 0;
    padding: 8px 16px;
    border: 0;
    border-radius: 999px;
    font: 600 12px var(--washi-font);
    color: var(--washi-sheet);
    background: var(--washi-red);
    cursor: pointer;
  }

  .cmd button:hover {
    background: var(--washi-bright-red);
  }

  .install p {
    margin-top: 18px;
    font-size: 13px;
    line-height: 1.9;
    color: var(--washi-muted);
  }

  /* 狭い画面: 余白を詰める */
  @media (max-width: 1100px) {
    .first,
    .movie,
    .points {
      padding-left: 48px;
      padding-right: 48px;
    }

    .pillars {
      gap: 48px;
    }

    .pt,
    .pt.r {
      grid-template-columns: 1.4fr 1fr;
      gap: 48px;
    }

    .pt.r {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  /* 2本柱とポイントを縦に積む */
  @media (max-width: 760px) {
    .nav,
    footer {
      padding-left: 16px;
      padding-right: 16px;
    }

    .nav nav,
    footer nav {
      gap: 8px 20px;
    }

    .first,
    .movie,
    .points {
      padding-left: 16px;
      padding-right: 16px;
    }

    .first {
      padding-top: 32px;
    }

    .pillars {
      grid-template-columns: 1fr;
      gap: 56px;
      padding-top: 36px;
    }

    .ph-ill {
      height: 200px;
    }

    .movie {
      padding-top: 72px;
    }

    .ph-movie {
      height: 360px;
    }

    .points {
      padding-top: 88px;
      gap: 72px;
    }

    .pt,
    .pt.r {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .pt.r .shot {
      order: 0;
    }

    .ph-shot {
      height: 260px;
    }

    .pl p br,
    .pt p br {
      display: none;
    }

    .more {
      margin-top: 72px;
    }

    .more span + span::before {
      margin: 0 8px;
    }

    .install {
      padding-top: 104px;
    }

    .cmd {
      gap: 12px;
      padding: 14px 14px 14px 18px;
      font-size: 13px;
    }

    footer {
      margin-top: 96px;
    }
  }
</style>
