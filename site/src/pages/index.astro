---
import "../styles/washi.css";
import { Image } from "astro:assets";
import logo from "../assets/kikigaki.png";
import Media from "../components/Media.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const docs = `${base}/docs/getting-started/`;
const repo = "https://github.com/tadashi-aikawa/kikigaki";
const blog = "https://nocturne.mamansoft.net/tags/KIKIGAKI/";
const siteUrl = "https://tadashi-aikawa.github.io/kikigaki/";
const title = "KIKIGAKI 聞書";
const heading = "声をすべてドキュメントに";
const description =
  "会議やひとりの声を、話す人ごとに書き起こしてMarkdownに残すmacOSアプリ。AIエージェントも会議に参加できます。";
const installCommand = "brew install --cask tadashi-aikawa/tap/kikigaki";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={`${title} | ${heading}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}kikigaki.png`} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href={`${base}/`}>
        <Image src={logo} alt="" width={24} height={24} />
        <b>KIKIGAKI</b><i>聞書</i>
      </a>
      <nav aria-label="サイト">
        <a href="#features">機能</a>
        <a href="#install">導入</a>
        <a href={docs}>ドキュメント</a>
        <a href={repo}>GitHub</a>
        <a href={blog} target="_blank" rel="noopener noreferrer">ブログ</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-copy">
            <div class="wordmark">
              <Image src={logo} alt="" width={76} height={76} />
              <span class="name"><b>KIKIGAKI</b><i>聞書</i></span>
            </div>
            <h1>{heading}</h1>
            <p class="sub">会議も、ひとりの声も、話す人ごとにMarkdownへ</p>
            <div class="hero-command">
              <code id="hero-install-command">{installCommand}</code>
              <button type="button" data-copy="hero-install-command" aria-label="インストールコマンドをコピー">コピー</button>
            </div>
            <div class="cta">
              <a class="button primary" href="#features">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
                機能を見る
              </a>
              <a class="button" href={docs}>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                ドキュメント
              </a>
              <a class="button" href={repo}>
                <svg aria-hidden="true" viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/></svg>
                GitHub
              </a>
            </div>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <Media src="illustrations/hero.png" alt="">
              <svg viewBox="0 0 520 500" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <g stroke-width="2" stroke-dasharray="2 7">
                  <path d="M120 112 C 190 120, 230 170, 262 214" stroke="#3E706C"/>
                  <path d="M92 232 C 160 236, 210 250, 250 270" stroke="#C4801F"/>
                  <path d="M132 356 C 190 350, 226 330, 254 318" stroke="#514A43"/>
                </g>
                <g stroke-width="2.2">
                  <path d="M40 72 h92 a16 16 0 0 1 16 16 v32 a16 16 0 0 1 -16 16 h-58 l-16 16 v-16 h-18 a16 16 0 0 1 -16 -16 v-32 a16 16 0 0 1 16 -16 z" fill="#fbf5ea" stroke="#3E706C"/>
                  <path d="M60 104 h52 M60 116 h30" stroke="#3E706C" stroke-width="2"/>
                  <path d="M20 196 h72 a16 16 0 0 1 16 16 v28 a16 16 0 0 1 -16 16 h-14 v16 l-16 -16 h-42 a16 16 0 0 1 -16 -16 v-28 a16 16 0 0 1 16 -16 z" fill="#fbf5ea" stroke="#C4801F"/>
                  <path d="M38 222 h44 M38 234 h24" stroke="#C4801F" stroke-width="2"/>
                  <path d="M56 320 h80 a16 16 0 0 1 16 16 v30 a16 16 0 0 1 -16 16 h-50 l-18 16 v-16 h-12 a16 16 0 0 1 -16 -16 v-30 a16 16 0 0 1 16 -16 z" fill="#fbf5ea" stroke="#514A43"/>
                  <path d="M74 348 h46 M74 360 h28" stroke="#514A43" stroke-width="2"/>
                </g>
                <g transform="rotate(3 390 260)">
                  <rect x="268" y="70" width="230" height="330" rx="6" fill="#ede0cd" transform="translate(6 8)"/>
                  <rect x="268" y="70" width="230" height="330" rx="6" fill="#fbf5ea" stroke="#514A43" stroke-width="2.2"/>
                  <path d="M292 106 h110" stroke="#221f1c" stroke-width="5"/>
                  <g stroke-width="3">
                    <circle cx="296" cy="148" r="4" fill="#3E706C" stroke="none"/><path d="M310 148 h160 M310 164 h120" stroke="#3E706C" opacity=".75"/>
                    <circle cx="296" cy="200" r="4" fill="#C4801F" stroke="none"/><path d="M310 200 h140 M310 216 h160 M310 232 h70" stroke="#C4801F" opacity=".75"/>
                    <circle cx="296" cy="270" r="4" fill="#514A43" stroke="none"/><path d="M310 270 h150 M310 286 h96" stroke="#514A43" opacity=".75"/>
                    <circle cx="296" cy="332" r="4" fill="#3E706C" stroke="none"/><path d="M310 332 h130 M310 348 h80" stroke="#3E706C" opacity=".75"/>
                  </g>
                </g>
              </svg>
            </Media>
          </div>
        </div>
        <a class="scroll-cue" href="#features" aria-label="下へスクロール">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </a>
      </section>

      <section class="first" id="features">
        <header class="section-head">
          <h2 class="section-kicker">二つの使い方</h2>
        </header>
        <div class="pillars">
          <div class="pl">
            <div class="ill">
              <Media src="illustrations/meeting-transparent.png" alt="会議の場面のイラスト">
                <div class="ph ph-ill">
                  <svg viewBox="0 0 340 180" aria-hidden="true">
                    <ellipse cx="170" cy="128" rx="120" ry="30"></ellipse>
                    <circle cx="70" cy="62" r="13"></circle><path d="M48 104q22-30 44 0"></path>
                    <circle cx="170" cy="40" r="13"></circle><path d="M148 82q22-30 44 0"></path>
                    <circle cx="270" cy="62" r="13"></circle><path d="M248 104q22-30 44 0"></path>
                    <path d="M150 132h40l6-26h-52z"></path><path d="M156 116h26M156 122h20"></path>
                    <path d="M92 50h28v14h-22l-6 6z" stroke="#3E706C"></path>
                    <path d="M192 26h28v14h-22l-6 6z" stroke="#C4801F"></path>
                    <path d="M228 50h-28v14h22l6 6z" stroke="#514A43"></path>
                    <rect x="296" y="96" width="26" height="18" rx="5" stroke="#3E706C" stroke-dasharray="3 3"></rect>
                  </svg>
                  <small>イラスト仮置き</small>
                </div>
              </Media>
            </div>
            <div class="tag t">会議で</div>
            <h2>話す人ごとに、AIも席に</h2>
            <p>誰が何を言ったかを分けて書き留めます。<br />AIエージェントは流れを読んで、論点や議事録をまとめます。</p>
          </div>

          <div class="pl">
            <div class="ill">
              <Media src="illustrations/solo-transparent.png" alt="ひとりで話す場面のイラスト">
                <div class="ph ph-ill">
                  <svg viewBox="0 0 340 180" aria-hidden="true">
                    <circle cx="70" cy="70" r="14"></circle><path d="M44 130q4-42 40-40"></path>
                    <path d="M30 140h150"></path><path d="M110 138l10-34h40l-6 34"></path>
                    <path d="M90 66q14-8 24 0t24 0" stroke="#3E706C"></path>
                    <rect x="150" y="40" width="18" height="14" stroke="#C4801F"></rect>
                    <rect x="176" y="62" width="18" height="14" stroke="#3E706C"></rect>
                    <rect x="160" y="84" width="18" height="14" stroke="#514A43"></rect>
                    <path d="M200 70h30" stroke-dasharray="3 4"></path>
                    <rect x="240" y="34" width="66" height="90" rx="2"></rect>
                    <path d="M252 50h34M252 66h42M252 78h38M252 90h30"></path>
                    <rect x="290" y="112" width="26" height="18" rx="5" stroke="#3E706C" stroke-dasharray="3 3"></rect>
                  </svg>
                  <small>イラスト仮置き</small>
                </div>
              </Media>
            </div>
            <div class="tag g">ひとりで</div>
            <h2>ひとりの声を、AIと形に</h2>
            <p>プレゼンの練習やアイデアの壁打ちに。<br />話した言葉をAIエージェントが拾って、構成やメモにまとめます。</p>
          </div>
        </div>
        <p class="ai-need">裏で動くのはAIエージェント(Claude Code か Codex のCLI)です。聞書とつなぐには <a href="https://herdr.dev/" target="_blank" rel="noopener noreferrer">herdr</a> を入れておきます</p>
      </section>

      <section class="movie" id="movie">
        <header class="section-head">
          <h2 class="section-kicker">動いているところ</h2>
          <p class="section-lead">3人の会議を録音中。話すと薄く出て、決まると濃くなる。頼むとAIエージェントの返事が並ぶ</p>
        </header>
        <div class="sheet">
          <Media src="demos/transcription.mp4" alt="対面の会議を録音中の書き起こしウィンドウ">
            <div class="ph ph-movie">
              <div class="what">
                <div class="play"></div>
                <b>動画 15〜20秒・無音ループ</b>
                対面の会議を録音中の書き起こしウィンドウ。<br />3人の発話が話者色つきで薄く出て、濃く決まっていく。<br />途中でAIエージェントの返事が1つ、発話の間に入る。
              </div>
              <small>動画仮置き</small>
            </div>
          </Media>
        </div>
      </section>

      <section class="points">
        <div class="pt">
          <div class="shot sheet">
            <Media src="captures/speakers.png" alt="3人の会議の書き起こし。最後の行が半透明">
              <div class="ph ph-shot">
                <div class="what"><b>キャプチャ</b>3人の会議の書き起こし。<br />上の行は濃く、最後の1〜2行が半透明。<br />話者名は付け直した名前で。</div>
                <small>画面仮置き</small>
              </div>
            </Media>
          </div>
          <div class="text">
            <div class="tag t">話す人ごとに</div>
            <h3>誰の声かを分けて書く</h3>
            <p>まだ変わるかもしれない行は薄く、<br />決まると濃くなります。<br />名前はあとから付け直せます。</p>
          </div>
        </div>

        <div class="pt r">
          <div class="shot sheet">
            <Media src="captures/ai-reply.png" alt="発話の行の間に並ぶAIエージェントの返事">
              <div class="ph ph-shot">
                <div class="what"><b>キャプチャ</b>発話の行の間に、AIエージェントの返事の行が並ぶところ。<br />返事は見出しと箇条書きのある短いまとめ。</div>
                <small>画面仮置き</small>
              </div>
            </Media>
          </div>
          <div class="text">
            <div class="tag g">AIも同じ流れに</div>
            <h3>AIエージェントの返事が話と並ぶ</h3>
            <p>頼んだ返事が、話の流れの中に入ってきます。<br />返事をするのはAIエージェント。頼み方は自分で決められます。</p>
          </div>
        </div>

        <div class="pt">
          <div class="shot sheet">
            <Media src="captures/minutes.png" alt="書き起こしの右に議事録ペインを開いた画面">
              <div class="ph ph-shot">
                <div class="what"><b>キャプチャ</b>書き起こしの右に議事録ペインを開いた全体。<br />左に会話、右にAIエージェントが書いた議事録。</div>
                <small>画面仮置き</small>
              </div>
            </Media>
          </div>
          <div class="text">
            <div class="tag s">議事録</div>
            <h3>議事録をその場で読む</h3>
            <p>AIエージェントが書いた議事録を、<br />書き起こしの右に開いて読めます。<br />書き換わると表示も追いつきます。</p>
          </div>
        </div>

        <div class="pt r">
          <div class="shot sheet">
            <Media src="captures/board.png" alt="議事録ペインのボードタブに、論点と決まったことが並ぶ画面">
              <div class="ph ph-shot">
                <div class="what"><b>キャプチャ</b>議事録ペインの「ボード」タブを開いたところ。</div>
                <small>画面仮置き</small>
              </div>
            </Media>
          </div>
          <div class="text">
            <div class="tag s">ボード</div>
            <h3>いま何の話かを、一枚で</h3>
            <p>議事録は、あとで読むもの。会議の途中で見るのはボード。論点と決まったことを、AIエージェントが一枚に更新し続けます。</p>
          </div>
        </div>

        <div class="pt">
          <div class="shot sheet">
            <Media src="captures/earphones.png" alt="録音開始シートでシステム音声を取り込む設定">
              <div class="ph ph-shot">
                <div class="what"><b>キャプチャ</b>録音開始シートで<br />マイクとシステム音声の混合を選んだところ。</div>
                <small>画面仮置き</small>
              </div>
            </Media>
          </div>
          <div class="text">
            <div class="tag t">イヤホンでも</div>
            <h3>相手の声も聞き取る</h3>
            <p>オンライン会議では、Macで流れる相手の声も<br />マイクと一緒に取り込みます。</p>
          </div>
        </div>
      </section>

      <p class="more"><span>URLや画像の手入力</span><span>会話をコピーしてほかのAIエージェントへ</span><span>会議ごとにMarkdownで保存</span></p>

      <section class="install" id="install">
        <h3>入れる</h3>
        <div class="cmd">
          <span><i>$</i> <code id="install-command">{installCommand}</code></span>
          <button type="button" data-copy="install-command">コピー</button>
        </div>
        <p>macOS 26以降。<br />初めて使うときに、話者判別のモデル(約193 MB)を取得します。</p>
      </section>
    </main>

    <footer>
      <a class="brand" href={`${base}/`}>
        <Image src={logo} alt="" width={22} height={22} />
        <b>KIKIGAKI</b><em>聞書</em>
      </a>
      <nav aria-label="フッター">
        <a href={docs}>ドキュメント</a>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/blob/main/LICENSE`}>MIT License</a>
        <a href={blog} target="_blank" rel="noopener noreferrer">ブログ</a>
      </nav>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
        button.addEventListener("click", async () => {
          const target = document.getElementById(button.dataset.copy ?? "");
          if (!target?.textContent) return;
          try {
            await navigator.clipboard.writeText(target.textContent);
            button.textContent = "コピーしました";
          } catch {
            button.textContent = "コピーできません";
          }
          setTimeout(() => (button.textContent = "コピー"), 2000);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .scroll-cue {
      animation: none !important;
    }
  }

  body {
    color: var(--washi-ink);
    font-family: var(--washi-font);
    background: var(--washi-paper) var(--washi-noise);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* ヘッダーとフッター */
  .nav,
  footer {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 32px;
    color: var(--washi-muted);
  }

  .nav {
    /* ナビを重ね、ヒーローだけで最初の1画面を満たす */
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    min-height: 64px;
    padding: 0 72px;
    font-size: 13px;
  }

  footer {
    margin-top: 120px;
    padding: 28px 72px 36px;
    font-size: 13px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    margin-right: auto;
  }

  .brand img {
    margin-right: 10px;
  }

  .brand b {
    color: var(--washi-ink);
    font-size: 14px;
    letter-spacing: 0.18em;
  }

  footer .brand b {
    font-size: 13px;
  }

  .brand i,
  .brand em {
    font-style: normal;
    margin-left: 10px;
  }

  .nav nav,
  footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }

  .nav nav a:hover,
  footer nav a:hover {
    color: var(--washi-ink);
  }

  /* 紙の面 */
  .sheet {
    position: relative;
    background: var(--washi-sheet);
    border-radius: 4px;
    box-shadow: var(--washi-sheet-shadow);
    overflow: hidden;
  }

  .ph {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .ph small {
    position: absolute;
    bottom: 8px;
    right: 12px;
    font-size: 10px;
    color: var(--washi-placeholder);
  }

  .what {
    padding: 0 24px;
    font-size: 14px;
    line-height: 1.9;
    color: var(--washi-muted);
  }

  .what b {
    display: block;
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--washi-placeholder);
  }

  .tag {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .tag.t {
    color: var(--washi-teal);
  }

  .tag.g {
    color: var(--washi-gold);
  }

  .tag.s {
    color: var(--washi-sumi);
  }

  /* ファーストビュー */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 64px 40px 72px;
  }

  .hero-grid {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .wordmark img {
    display: block;
    width: 76px;
    height: 76px;
  }

  .wordmark .name {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .wordmark b {
    font-size: 60px;
    font-weight: 800;
    color: var(--washi-ink);
    letter-spacing: 0.06em;
  }

  .wordmark i {
    margin-top: 8px;
    padding-left: 0.2em;
    font-size: 15px;
    font-style: normal;
    color: var(--washi-muted);
    letter-spacing: 0.4em;
  }

  .hero h1 {
    margin-top: 18px;
    font-size: 40px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.35;
  }

  .hero .sub {
    margin-top: -10px;
    font-size: 17px;
    line-height: 1.8;
    color: var(--washi-muted);
  }

  .hero-command {
    display: inline-flex;
    align-items: center;
