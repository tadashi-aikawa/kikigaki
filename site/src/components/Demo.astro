---
import { existsSync } from "node:fs";
import { join } from "node:path";

interface Props {
  /** public/ からの相対パス。例: demos/transcription.mp4 */
  src: string;
  label: string;
}

const { src, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// 動画はまだ撮っていない。public/ に置いた時点で表示し、無ければ枠ごと出さない
const exists = existsSync(join(process.cwd(), "public", src));
---

{
  exists && (
    <video
      class="demo"
      src={`${base}/${src}`}
      aria-label={label}
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
    />
  )
}

<style>
  .demo {
    display: block;
    width: 100%;
    margin-top: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--shade);
  }
</style>
