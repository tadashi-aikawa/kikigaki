---
// Starlight の SiteTitle の差し替え。トップのヘッダーと同じロゴと「KIKIGAKI 聞書」にして、トップへ戻す
import { Image } from "astro:assets";
import logo from "../assets/kikigaki.png";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a href={`${base}/`} class="site-title">
  <Image src={logo} alt="" width={24} height={24} />
  <b translate="no">KIKIGAKI</b><span>聞書</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    color: var(--sl-color-gray-3);
    font-size: 13px;
    text-decoration: none;
    white-space: nowrap;
  }

  img {
    width: 24px;
    height: 24px;
    margin-right: 10px;
  }

  b {
    color: var(--sl-color-white);
    font-size: 14px;
    letter-spacing: 0.18em;
  }

  span {
    margin-left: 10px;
  }
</style>
